+bool msm_dsi_host_live_total(struct mipi_dsi_host *host,
+			    const struct drm_display_mode *mode, u32 *total)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	int width, old_total, horizontal, vertical;
+	u32 active, value;
+
+	if (!msm_host->power_on || !msm_host->enabled || !msm_host->mode ||
+	    !msm_host->dsc || msm_host->lanes != 4 ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) ||
+	    !(dsi_read(msm_host, REG_DSI_CTRL) & DSI_CTRL_VID_MODE_EN))
+		return false;
+
+	if (mode->htotal % 2 || msm_host->mode->htotal % 2)
+		return false;
+
+	active = dsi_read(msm_host, REG_DSI_ACTIVE_H);
+	width = (int)FIELD_GET(DSI_ACTIVE_H_END__MASK, active) -
+		(int)FIELD_GET(DSI_ACTIVE_H_START__MASK, active);
+	if (width <= 0)
+		return false;
+	old_total = (msm_host->mode->htotal - msm_host->mode->hdisplay) / 2 + width - 1;
+	horizontal = (mode->htotal - mode->hdisplay) / 2 + width - 1;
+	vertical = mode->vtotal - 1;
+	value = dsi_read(msm_host, REG_DSI_TOTAL);
+	if (old_total != FIELD_GET(DSI_TOTAL_H_TOTAL__MASK, value) ||
+	    msm_host->mode->vtotal - 1 != FIELD_GET(DSI_TOTAL_V_TOTAL__MASK, value) ||
+	    horizontal <= 0 || horizontal > FIELD_MAX(DSI_TOTAL_H_TOTAL__MASK) ||
+	    vertical <= 0 || vertical > FIELD_MAX(DSI_TOTAL_V_TOTAL__MASK))
+		return false;
+
+	*total = (value & ~(DSI_TOTAL_H_TOTAL__MASK | DSI_TOTAL_V_TOTAL__MASK)) |
+		 DSI_TOTAL_H_TOTAL(horizontal) | DSI_TOTAL_V_TOTAL(vertical);
+	return true;
+}
+
+void msm_dsi_host_apply_live_total(struct mipi_dsi_host *host,
+				  const struct drm_display_mode *mode, u32 total)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 active_h = dsi_read(msm_host, REG_DSI_ACTIVE_H);
+	u32 active_v = dsi_read(msm_host, REG_DSI_ACTIVE_V);
+	u32 hsync = dsi_read(msm_host, REG_DSI_ACTIVE_HSYNC);
+	u32 vsync_hpos = dsi_read(msm_host, REG_DSI_ACTIVE_VSYNC_HPOS);
+	u32 vsync_vpos = dsi_read(msm_host, REG_DSI_ACTIVE_VSYNC_VPOS);
+
+	dsi_write(msm_host, REG_DSI_TIMING_DB_MODE, DSI_TIMING_DB_MODE_ENABLE);
+	wmb();
+	dsi_write(msm_host, REG_DSI_ACTIVE_H, active_h);
+	dsi_write(msm_host, REG_DSI_ACTIVE_V, active_v);
+	dsi_write(msm_host, REG_DSI_TOTAL, total);
+	dsi_write(msm_host, REG_DSI_ACTIVE_HSYNC, hsync);
+	dsi_write(msm_host, REG_DSI_ACTIVE_VSYNC_HPOS, vsync_hpos);
+	dsi_write(msm_host, REG_DSI_ACTIVE_VSYNC_VPOS, vsync_vpos);
+	wmb();
+	dsi_write(msm_host, REG_DSI_TIMING_FLUSH, DSI_TIMING_FLUSH_REQUEST);
+	DBG("live video timing: active_h=%#x active_v=%#x total=%#x",
+	    active_h, active_v, total);
+	drm_mode_copy(msm_host->mode, mode);
+}
