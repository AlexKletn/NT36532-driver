+static bool spinel_seamless;
+module_param(spinel_seamless, bool, 0644);
+MODULE_PARM_DESC(spinel_seamless, "Experimental live 30/60/120/144 Hz modeset on the Spinel panel");
+
+static bool spinel_stock_mode(const struct drm_display_mode *mode)
+{
+	if (mode->hdisplay != 2944 || mode->vdisplay != 1840)
+		return false;
+
+	switch (drm_mode_vrefresh(mode)) {
+	case 30:
+		return mode->htotal == 3490 && mode->vtotal == 8200 && mode->clock == 858540;
+	case 60:
+		return mode->htotal == 3490 && mode->vtotal == 4100 && mode->clock == 858540;
+	case 120:
+		return mode->htotal == 3490 && mode->vtotal == 2050 && mode->clock == 858540;
+	case 144:
+		return mode->htotal == 3234 && mode->vtotal == 2050 &&
+		       mode->clock == 3234 * 2050 * 144 / 1000;
+	default:
+		return false;
+	}
+}
+
+static bool spinel_live_modes(const struct drm_display_mode *old,
+			      const struct drm_display_mode *new)
+{
+	struct drm_display_mode normalized;
+
+	if (!spinel_stock_mode(old) || !spinel_stock_mode(new) ||
+	    drm_mode_vrefresh(old) == drm_mode_vrefresh(new))
+		return false;
+
+	if (old->hsync_start - old->htotal != new->hsync_start - new->htotal ||
+	    old->hsync_end - old->htotal != new->hsync_end - new->htotal ||
+	    old->vsync_start - old->vtotal != new->vsync_start - new->vtotal ||
+	    old->vsync_end - old->vtotal != new->vsync_end - new->vtotal)
+		return false;
+	drm_mode_init(&normalized, new);
+	normalized.clock = old->clock;
+	normalized.hsync_start = old->hsync_start;
+	normalized.hsync_end = old->hsync_end;
+	normalized.htotal = old->htotal;
+	normalized.vsync_start = old->vsync_start;
+	normalized.vsync_end = old->vsync_end;
+	normalized.vtotal = old->vtotal;
+	return drm_mode_equal(old, &normalized);
+}
+
+static struct drm_panel *spinel_live_panel(struct drm_encoder *encoder)
+{
+	struct drm_bridge *bridge;
+	struct drm_panel *panel;
+	struct device_node *node;
+	struct msm_dsi *dsi;
+	int id;
+
+	bridge = drm_bridge_chain_get_first_bridge(encoder);
+	if (!bridge)
+		return NULL;
+	id = bridge->funcs == &dsi_mgr_bridge_funcs ? dsi_mgr_bridge_get_id(bridge) : -1;
+	drm_bridge_put(bridge);
+	if (id < 0 || !IS_MASTER_DSI_LINK(id)) {
+		drm_info(encoder->dev, "spinel: live switch skipped: no master DSI bridge\n");
+		return NULL;
+	}
+
+	dsi = dsi_mgr_get_dsi(id);
+	if (!dsi)
+		return NULL;
+	node = of_graph_get_remote_node(dsi->pdev->dev.of_node, 1, 0);
+	if (!node) {
+		drm_info(encoder->dev, "spinel: live switch skipped: no panel endpoint\n");
+		return NULL;
+	}
+	panel = of_device_is_compatible(node, "lenovo,spinel-display") ?
+		of_drm_find_panel(node) : ERR_PTR(-ENODEV);
+	of_node_put(node);
+	if (IS_ERR(panel) || !panel->prepared || !panel->funcs ||
+	    !panel->funcs->set_live_refresh) {
+		if (!IS_ERR(panel))
+			drm_panel_put(panel);
+		drm_info(encoder->dev, "spinel: live switch skipped: panel callback unavailable\n");
+		return NULL;
+	}
+	return panel;
+}
+
+static bool spinel_live_commit(struct drm_encoder *encoder,
+			       struct drm_crtc_state *crtc_state)
+{
+	struct msm_drm_private *priv = encoder->dev->dev_private;
+	struct msm_kms *kms = priv->kms;
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+	const struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	struct drm_panel *panel;
+	u32 total_master, total_slave;
+	int ret;
+
+	if (!IS_BONDED_DSI() || !master || !slave ||
+	    !kms->funcs->stage_live_timing || !kms->funcs->flush_live_timing)
+		return false;
+
+	panel = spinel_live_panel(encoder);
+	if (!panel)
+		return false;
+
+	if (!msm_dsi_host_live_total(master->host, mode, &total_master) ||
+	    !msm_dsi_host_live_total(slave->host, mode, &total_slave)) {
+		drm_info(encoder->dev, "spinel: live switch skipped: DSI host timing mismatch\n");
+		goto put_panel;
+	}
+
+	if (drm_crtc_wait_one_vblank(crtc_state->crtc) ||
+	    !kms->funcs->stage_live_timing(encoder, mode)) {
+		drm_info(encoder->dev, "spinel: live switch skipped: DPU timing or vblank unavailable\n");
+		goto put_panel;
+	}
+	msm_dsi_host_apply_live_total(master->host, mode, total_master);
+	msm_dsi_host_apply_live_total(slave->host, mode, total_slave);
+
+	ret = panel->funcs->set_live_refresh(panel, drm_mode_vrefresh(mode));
+	if (ret) {
+		drm_warn(encoder->dev,
+			 "spinel: live refresh command failed (%d), falling back to full modeset\n", ret);
+		goto put_panel;
+	}
+	drm_info(encoder->dev, "spinel: live DPU and DSI timings staged at %d Hz\n",
+		 drm_mode_vrefresh(mode));
+	drm_panel_put(panel);
+	return true;
+
+put_panel:
+	drm_panel_put(panel);
+	return false;
+}
+
+unsigned int msm_dsi_try_live_modeset(struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *old_crtc, *new_crtc;
+	struct drm_encoder *encoder;
+	struct drm_crtc *crtc;
+	unsigned int live_encoders = 0;
+	int i;
+
+	if (!READ_ONCE(spinel_seamless))
+		return 0;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old_crtc, new_crtc, i) {
+		if (!spinel_live_modes(&old_crtc->mode, &new_crtc->mode))
+			continue;
+		if (!old_crtc->active || !new_crtc->active || !new_crtc->mode_changed ||
+		    new_crtc->active_changed || new_crtc->connectors_changed ||
+		    new_crtc->connector_mask != old_crtc->connector_mask ||
+		    new_crtc->encoder_mask != old_crtc->encoder_mask ||
+		    hweight32(new_crtc->encoder_mask) != 1 ||
+		    new_crtc->ctm != old_crtc->ctm ||
+		    !spinel_live_modes(&old_crtc->adjusted_mode, &new_crtc->adjusted_mode)) {
+			drm_info(state->dev,
+				 "spinel: live switch skipped: atomic state active %d/%d, changed=%d/%d/%d, encoders=%#x/%#x, connectors=%#x/%#x\n",
+				 old_crtc->active, new_crtc->active, new_crtc->mode_changed,
+				 new_crtc->active_changed, new_crtc->connectors_changed,
+				 old_crtc->encoder_mask, new_crtc->encoder_mask,
+				 old_crtc->connector_mask, new_crtc->connector_mask);
+			continue;
+		}
+		drm_for_each_encoder_mask(encoder, state->dev, new_crtc->encoder_mask) {
+			if (spinel_live_commit(encoder, new_crtc)) {
+				new_crtc->mode_changed = false;
+				live_encoders |= drm_encoder_mask(encoder);
+			}
+		}
+	}
+	return live_encoders;
+}
